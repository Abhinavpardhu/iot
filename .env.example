# ==============================================================
# IoT Smart Home Automation System - Environment Configuration
# ==============================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Initial Operating Mode: 'demo' (default for college review) or 'hardware'
SYSTEM_MODE=demo

# Simulation parameters (used when SYSTEM_MODE=demo)
SIMULATOR_INTERVAL_MS=3500

# Physical MQTT Broker Parameters (used when SYSTEM_MODE=hardware)
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_CLIENT_ID=esp32_smart_home_backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=home
